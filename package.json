{
  "name": "new-password-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:desktop": "npm run build --workspace @newpm/desktop",
    "package:windows": "npm run package:windows --workspace @newpm/desktop",
    "dev:desktop": "npm run dev --workspace @newpm/desktop",
    "start:android": "npm run start --workspace @newpm/android",
    "prebuild:android": "npm run prebuild --workspace @newpm/android",
    "build:android:debug": "bash scripts/build-android.sh",
    "run:android": "npm run android --workspace @newpm/android",
    "bundle:android": "npm run bundle --workspace @newpm/android"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
